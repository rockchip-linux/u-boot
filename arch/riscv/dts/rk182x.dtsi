	soc: soc {
		compatible = "simple-bus";
		interrupt-parent = <&plic>;
		#address-cells = <2>;
		#size-cells = <2>;
		dma-noncoherent;
		ranges;

		loc_cru: clock-controller@c00400000 {
			compatible = "rockchip,rk182x-loc-cru";
			reg = <0x0c 0x00400000 0x0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			clocks = <&cru PLL_L0PLL>;

			assigned-clocks =
				<&loc_cru ACLK_NBCT_ROOT>, <&loc_cru PCLK_ROOT_LOCSYS>,
				<&loc_cru LCLK_SUBTOLOC_BIU>, <&loc_cru ACLK_RKNN_LOCSYS>,
				<&loc_cru CLK_CORE_LOCSYS>, <&loc_cru ACLK_BRIDGE_BIU>;
			assigned-clock-rates =
				<500000000>, <100000000>,
				<100000000>, <750000000>,
				<1000000000>, <500000000>;
		};

		plic: interrupt-controller@1008000000 {
			compatible = "rockchip,rk182x-plic", "thead,c900-plic";
			reg = <0x10 0x08000000 0x0 0x04000000>;
			interrupts-extended = <&cpu0_intc 11>, <&cpu0_intc 9>;
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <2>;
			riscv,ndev = <160>;
		};

		php_grf: syscon@1030020000 {
			compatible = "rockchip,rk182x-php-grf", "syscon";
			reg = <0x10 0x30020000 0x0 0x1000>;
		};

		ioc_grf: syscon@1030400000 {
			compatible = "rockchip,rk182x-ioc-grf", "syscon";
			reg = <0x10 0x30400000 0x0 0x1000>;
		};

		cru: clock-controller@1030800000 {
			compatible = "rockchip,rk182x-cru";
			reg = <0x10 0x30800000 0x0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;

			assigned-clocks =
				<&cru PLL_GPLL>, <&cru PLL_MPLL>,
				<&cru PLL_L0PLL>, <&cru CLK_AUDIO_FRAC_0>,
				<&cru CLK_UART_FRAC_0>, <&cru CLK_UART_FRAC_1>,
				<&cru CLK_UART_FRAC_2>, <&cru CLK_CORE>;
			assigned-clock-rates =
				<1000000000>, <800000000>,
				<1500000000>, <49152000>,
				<128000000>, <96000000>,
				<18432000>, <1000000000>;
		};

		uart0: serial@1031880000 {
			compatible = "rockchip,rk182x-uart", "snps,dw-apb-uart";
			reg = <0x10 0x31880000 0x0 0x100>;
			interrupts = <21 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART0>, <&cru PCLK_UART0>;
			clock-names = "baudclk", "apb_pclk";
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		combphy0_p: phy@1031c30000 {
			compatible = "rockchip,rk182x-naneng-combphy";
			reg = <0x10 0x31c30000 0x0 0x10000>;
			#phy-cells = <1>;
			clocks = <&cru CLK_REF_PCIE0_INNER_PHY>,
				 <&cru PCLK_PCIE0PHY>,
				 <&cru PCLK_PCIE0>;
			clock-names = "refclk", "apbclk", "pipe_clk";
			assigned-clocks = <&cru CLK_REF_PCIE0_INNER_PHY>;
			assigned-clock-rates = <100000000>;
			resets = <&cru SRST_PRESETN_PCIE0PHY>,
				 <&cru SRST_RESETN_PCIE0_PIPE_PHY>;
			reset-names = "combphy-apb", "combphy";
			rockchip,ext-refclk;
			rockchip,rx-termination-hiz;
			rockchip,pipe-grf = <&php_grf>;
			rockchip,pipe-phy-grf = <&pipe_phy0_grf>;
			status = "disabled";
		};

		pipe_phy0_grf: syscon@1031c40000 {
			compatible = "rockchip,pipe-phy-grf", "syscon";
			reg = <0x10 0x31c40000 0x0 0x100>;
		};

		pcie0: pcie@1031c50000 {
			compatible = "rockchip,rk182x-pcie-std-ep", "rockchip,rk3568-pcie-std-ep";
			#address-cells = <3>;
			#size-cells = <2>;
			bus-range = <0x0 0x0f>;
			clocks = <&cru ACLK_PCIE0_MSTR>, <&cru ACLK_PCIE0_SLV>,
				 <&cru ACLK_PCIE0_DBI>, <&cru PCLK_PCIE0>,
				 <&cru CLK_PCIE0_AUX>;
			clock-names = "aclk_mst", "aclk_slv",
				      "aclk_dbi", "pclk",
				      "aux";
			device_type = "pci";
			interrupts = <96 IRQ_TYPE_LEVEL_HIGH>,
				     <98 IRQ_TYPE_LEVEL_HIGH>,
				     <97 IRQ_TYPE_LEVEL_HIGH>,
				     <100 IRQ_TYPE_LEVEL_HIGH>,
				     <99 IRQ_TYPE_LEVEL_HIGH>,
				     <101 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi", "sys", "pmc", "msg", "legacy", "err";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie0_intc 0>,
					<0 0 0 2 &pcie0_intc 1>,
					<0 0 0 3 &pcie0_intc 2>,
					<0 0 0 4 &pcie0_intc 3>;
			linux,pci-domain = <0>;
			num-ib-windows = <16>;
			num-ob-windows = <16>;
			num-viewport = <16>;
			max-link-speed = <2>;
			num-lanes = <1>;
			phys = <&combphy0_p PHY_TYPE_PCIE>;
			phy-names = "pcie-phy";
			ranges = <0x00000800 0x00 0x10000000 0x10 0x10000000 0x0 0x00100000
				  0x81000000 0x00 0x10100000 0x10 0x10100000 0x0 0x00100000
				  0x82000000 0x00 0x10200000 0x10 0x10200000 0x0 0x07e00000
				  0x83000000 0x11 0x00000000 0x11 0x00000000 0x0 0x80000000>;
			reg = <0x10 0x31c50000 0x0 0x00010000>,
			      <0x10 0x21000000 0x0 0x00400000>,
			      <0x10 0x10000000 0x0 0x00100000>;
			reg-names = "pcie-apb", "pcie-dbi", "config";
			resets = <&cru SRST_RESETN_PCIE0_POWER_UP>, <&cru SRST_PRESETN_PCIE0>;
			reset-names = "pipe", "p_pcie";
			status = "disabled";

			pcie0_intc: legacy-interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-parent = <&plic>;
				interrupts = <99 IRQ_TYPE_EDGE_RISING>;
			};
		};

		combphy1_pu: phy@1031c60000 {
			compatible = "rockchip,rk182x-naneng-combphy";
			reg = <0x10 0x31c60000 0x0 0x10000>;
			#phy-cells = <1>;
			clocks = <&cru CLK_REF_PCIE1_INNER_PHY>,
				 <&cru PCLK_PCIE1PHY>,
				 <&cru PCLK_PCIE1>;
			clock-names = "refclk", "apbclk", "pipe_clk";
			assigned-clocks = <&cru CLK_REF_PCIE1_INNER_PHY>;
			assigned-clock-rates = <100000000>;
			resets = <&cru SRST_PRESETN_PCIE1PHY>,
				 <&cru SRST_RESETN_PCIE1_PIPE_PHY>;
			reset-names = "combphy-apb", "combphy";
			rockchip,pipe-grf = <&php_grf>;
			rockchip,pipe-phy-grf = <&pipe_phy1_grf>;
			status = "disabled";
		};

		pipe_phy1_grf: syscon@1031c70000 {
			compatible = "rockchip,pipe-phy-grf", "syscon";
			reg = <0x10 0x31c70000 0x0 0x100>;
		};

		pcie1: pcie@1031c80000 {
			compatible = "rockchip,rk182x-pcie", "rockchip,rk3568-pcie";
			#address-cells = <3>;
			#size-cells = <2>;
			bus-range = <0x10 0x1f>;
			clocks = <&cru ACLK_PCIE1_MSTR>, <&cru ACLK_PCIE1_SLV>,
				 <&cru ACLK_PCIE1_DBI>, <&cru PCLK_PCIE1>,
				 <&cru CLK_PCIE1_AUX>;
			clock-names = "aclk_mst", "aclk_slv",
				      "aclk_dbi", "pclk",
				      "aux";
			device_type = "pci";
			interrupts = <78 IRQ_TYPE_LEVEL_HIGH>,
				     <80 IRQ_TYPE_LEVEL_HIGH>,
				     <79 IRQ_TYPE_LEVEL_HIGH>,
				     <82 IRQ_TYPE_LEVEL_HIGH>,
				     <81 IRQ_TYPE_LEVEL_HIGH>,
				     <83 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi", "sys", "pmc", "msg", "legacy", "err";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie1_intc 0>,
					<0 0 0 2 &pcie1_intc 1>,
					<0 0 0 3 &pcie1_intc 2>,
					<0 0 0 4 &pcie1_intc 3>;
			linux,pci-domain = <0>;
			num-ib-windows = <16>;
			num-ob-windows = <16>;
			num-viewport = <16>;
			max-link-speed = <2>;
			num-lanes = <1>;
			phys = <&combphy1_pu PHY_TYPE_PCIE>;
			phy-names = "pcie-phy";
			ranges = <0x00000800 0x00 0x18000000 0x10 0x18000000 0x0 0x00100000
				  0x81000000 0x00 0x18100000 0x10 0x18100000 0x0 0x00100000
				  0x82000000 0x00 0x18200000 0x10 0x18200000 0x0 0x07e00000
				  0x83000000 0x11 0x80000000 0x11 0x80000000 0x0 0x80000000>;
			reg = <0x10 0x31c80000 0x0 0x00010000>,
			      <0x10 0x23000000 0x0 0x00400000>,
			      <0x10 0x18000000 0x0 0x00100000>;
			reg-names = "pcie-apb", "pcie-dbi", "config";
			resets = <&cru SRST_RESETN_PCIE1_POWER_UP>, <&cru SRST_PRESETN_PCIE1>;
			reset-names = "pipe", "p_pcie";
			status = "disabled";

			pcie1_intc: legacy-interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-parent = <&plic>;
				interrupts = <81 IRQ_TYPE_EDGE_RISING>;
			};
		};

		mmc: mmc@1032020000 {
			compatible = "rockchip,rk182x-dw-mshc", "rockchip,rk3576-dw-mshc";
			reg = <0x10 0x32020000 0x0 0x4000>;
			interrupts = <3 IRQ_TYPE_LEVEL_HIGH>;
			max-frequency = <200000000>;
			clocks = <&cru HCLK_SDMMC0>, <&cru CCLK_SRC_SDMMC0>;
			clock-names = "biu", "ciu";
			fifo-depth = <0x100>;
			resets = <&cru SRST_HRESETN_SDMMC0>;
			reset-names = "reset";
			status = "disabled";
		};
	};
};

#include "rk182x-pinctrl.dtsi"
