#include <dt-bindings/input/input.h>
#include "rockchip-u-boot.dtsi"

/ {
	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
	};

	chosen {
		u-boot,spl-boot-order = "same-as-spl", &sdhci;
	};

	dmc {
		compatible = "rockchip,rk3572-dmc";
		bootph-all;
		status = "okay";
	};
};

&combphy0_psu {
	bootph-all;
	status = "okay";
};

&gpio0 {
	bootph-all;
	status = "okay";
};

&gpio1 {
	bootph-all;
	status = "okay";
};

&gpio2 {
	bootph-all;
	status = "okay";
};

&gpio3 {
	bootph-all;
	status = "okay";
};

&gpio4 {
	bootph-all;
	status = "okay";
};

&ioc_grf {
	bootph-all;
	status = "okay";
};

&cru {
	bootph-all;
	status = "okay";
};

&psci {
	bootph-all;
	status = "okay";
};

&php_grf {
	bootph-all;
	status = "okay";
};

&pinctrl {
	bootph-all;
	status = "okay";
};

&pipe_phy0_grf {
	bootph-all;
	status = "okay";
};

&pcfg_pull_up {
	bootph-all;
	status = "okay";
};

&pcfg_pull_none {
	bootph-all;
	status = "okay";
};

&saradc {
	bootph-all;
	status = "okay";
};

&sdhci {
	bootph-all;
	bus-width = <8>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	no-sd;
	no-sdio;
	non-removable;
	u-boot,spl-fifo-mode;
	status = "okay";
};

&rng {
	bootph-all;
	status = "okay";
};

&usb2phy_grf {
	bootph-all;
	status = "okay";
};

&u2phy0 {
	bootph-all;
	status = "okay";
};

&u2phy0_otg {
	bootph-all;
	status = "okay";
};

&ufs {
	bootph-all;
	status = "okay";
};
