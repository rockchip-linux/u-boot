#include "rk3588-u-boot.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Rockchip RK3588 Evaluation Board";
	compatible = "rockchip,rk3588-evb", "rockchip,rk3588";

	chosen {
		u-boot,spl-boot-order = &sdmmc, "same-as-spl", &sdhci;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		bootph-all;
		status = "okay";

		volumeup-key {
			bootph-all;
			linux,code = <KEY_VOLUMEUP>;
			label = "volume up";
			press-threshold-microvolt = <1750>;
		};
	};

	bootstd {
		compatible = "u-boot,boot-std";
		bootph-all;
		filename-prefixes = "/", "/boot/";
		bootdev-order = "mmc0";

		extlinux {
			bootph-all;
			compatible = "u-boot,extlinux";
		};
	};
};

&otp {
	bootph-all;
	status = "okay";
};

&optee {
	bootph-all;
};

&php_grf {
	bootph-all;
};

&saradc {
	bootph-all;
	status = "okay";
};

&gpio0 {
	bootph-all;
	status = "okay";
};

&gpio1 {
	bootph-all;
	status = "okay";
};

&gpio2 {
	bootph-all;
	status = "okay";
};

&gpio3 {
	bootph-all;
	status = "okay";
};

&gpio4 {
	bootph-all;
	status = "okay";
};

&crypto {
	bootph-all;
	status = "okay";
};

&rng {
	bootph-all;
	status = "okay";
};


