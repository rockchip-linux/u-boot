# CONFIG_ANDROID_AVB is not set
# CONFIG_ANDROID_BOOT_IMAGE_HASH is not set
# CONFIG_ANDROID_KEYMASTER_CA is not set
# CONFIG_ANDROID_WRITE_KEYBOX is not set
# CONFIG_ARM64_SUPPORT_AARCH32 is not set
# CONFIG_ARM_CPU_SUSPEND is not set
CONFIG_BASE_DEFCONFIG="rk3576_defconfig"
# CONFIG_CMD_BOOT_ANDROID is not set
# CONFIG_CMD_MTD_BLK is not set
# CONFIG_DM_CHARGE_DISPLAY is not set
# CONFIG_DM_ETH is not set
# CONFIG_DM_ETH_PHY is not set
# CONFIG_DM_FUEL_GAUGE is not set
CONFIG_DM_MAILBOX=y
# CONFIG_DM_POWER_DELIVERY is not set
CONFIG_FASTBOOT_BUF_ADDR=0x5d900000
CONFIG_LOADER_INI="RK3576MINIALL_MOS.ini"
# CONFIG_MISC_DECOMPRESS is not set
CONFIG_MMC_SDHCI_ADMA_HELPERS=y
CONFIG_MMC_SDHCI_ADMA=y
# CONFIG_MMC_SDHCI_SDMA is not set
CONFIG_MOS_BOOTDEV_NAME="/mmc@2a330000"
# CONFIG_MOS_BOOTDEV_SHARED is not set
# CONFIG_MOS_SECONDARY is not set
CONFIG_MOS_SUPPORT=y
CONFIG_MOS_SYSCFG_ADDR=0x41400000
# CONFIG_MTD_DEVICE is not set
# CONFIG_MTD is not set
# CONFIG_MTD_NAND_BBT_USING_FLASH is not set
# CONFIG_NETDEVICES is not set
# CONFIG_PHYLIB is not set
CONFIG_POWER_DOMAIN=y
CONFIG_ROCKCHIP_CLK_DCLK_MOS=y
CONFIG_ROCKCHIP_MBOX=y
# CONFIG_ROCKCHIP_SFC is not set
# CONFIG_SANITY_CPU_SWAP is not set
CONFIG_SCMI_POWER_DOMAIN=y
CONFIG_SMP=y
# CONFIG_SPI_FLASH is not set
CONFIG_SPL_CRYPTO_SUPPORT=y
CONFIG_SPL_FIT_IMAGE_KB=4096
CONFIG_SPL_FIT_IMAGE_MULTIPLE=1
CONFIG_SPL_HASH_SUPPORT=y
# CONFIG_SPL_MISC_DECOMPRESS is not set
CONFIG_SPL_MMC_SDHCI_ADMA=y
# CONFIG_SPL_MMC_SDHCI_SDMA is not set
# CONFIG_SPL_MTD_SUPPORT is not set
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_SPI_SUPPORT is not set
CONFIG_TRUST_INI="RK3576TRUST_MOS_PRIMARY.ini"
CONFIG_SPL_SPINLOCK_SUPPORT=y
CONFIG_DM_HWSPINLOCK=y
CONFIG_SPL_DM_HWSPINLOCK=y
CONFIG_HWSPINLOCK_ROCKCHIP=y
CONFIG_SPL_HWSPINLOCK_ROCKCHIP=y
CONFIG_RESET_SCMI=y
CONFIG_SPL_SKIP_RELOCATE=y
