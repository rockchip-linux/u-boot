menuconfig DICE
	bool "DICE Support"
	depends on ANDROID_BOOT_IMAGE
	help
	  This option provides DICE support.

if DICE

config SPL_DICE
        bool "Enable dice for SPL"
	help
	  This option provides DICE support in SPL.

config DICE_WIDEVINE
	bool "DICE support Widevine"
	depends on ANDROID_BOOT_IMAGE
	default y
	help
	  This option provides support for Widevine.

endif # DICE
